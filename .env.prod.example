# Copy to .env.prod and fill in. Git ignores .env.prod: never commit real values.
# Used by `make prod-build` / `make prod-up` (compose.prod.yaml, docs/deploy.md).

# The production database password. Letters and digits only (it goes into a URL).
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The password of the API's own database role (db/roles.py). Letters and digits only.
# Make one with: openssl rand -hex 24
API_DB_PASSWORD=

# The password of the read-only role the public demo API uses (db/roles.py). Letters and digits.
# Make one with: openssl rand -hex 24
DEMO_DB_PASSWORD=

# The instructor dashboard's shared token (at least 16 characters; empty = dashboard off).
# Make one with: openssl rand -hex 24
INSTRUCTOR_TOKEN=

# Proxies in front of the API that add to X-Forwarded-For: 1 = the web container (Next.js).
# Deploy Step 5 adds Caddy in front: then 2. Never more than the real number (docs/deploy.md).
# TRUSTED_PROXY_HOPS=1

# The container runtime for grading strangers' code. On the server: runsc (gVisor, installed by
# deploy/install-gvisor.sh). Empty = plain Docker (a laptop; not for strangers). If it is set and
# Docker doesn't have it, the worker refuses to start (it never falls back).
SANDBOX_RUNTIME=

# The hint model, run on the server's CPU in the stack's own Ollama (make prod-tutor-up).
# Chosen by the measurement in docs/tutor.md §6. Student code never leaves the server.
# TUTOR_MODEL=ollama/qwen2.5-coder:1.5b
