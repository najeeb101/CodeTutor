# Copy this file to .env and fill in the values. Git ignores .env: never commit real keys.
# Use it with: uv run --env-file .env python scripts/try_model.py ...

# Google AI Studio key, from a project WITHOUT billing (free tier only).
# Before every commit: uv run python scripts/check_secrets.py
GEMINI_API_KEY=

